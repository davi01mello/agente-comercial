# Copie este arquivo para .env e preencha. O .env NUNCA vai para o Git.

# Chave da API do Claude (peça ao Davi; nunca compartilhe no chat/print)
ANTHROPIC_API_KEY=

# Modelos (troque se o Davi orientar)
MODEL_CURADOR=claude-sonnet-5
MODEL_CONSULTOR=claude-sonnet-5

# Banco: SQLite local funciona sem instalar nada. Em produção (Railway) vira Postgres.
DATABASE_URL=sqlite:///./data/cerebro.db

# Ambiente
APP_ENV=dev
