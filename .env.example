# Copie este arquivo para .env e preencha. O .env NUNCA vai para o Git.

# Chave da API do Gemini: crie em aistudio.google.com/apikey (ou peça ao Davi).
# Nunca compartilhe no chat/print.
GEMINI_API_KEY=

# Modelos. Se der limite (429) ou sobrecarga (503, comum na camada gratuita),
# teste gemini-3.5-flash-lite.
MODEL_CURADOR=gemini-3.8-flash
MODEL_CONSULTOR=gemini-3.8-flash

# Tempo máximo (segundos) esperando UMA chamada ao modelo responder.
LLM_TIMEOUT_S=30

# Tempo máximo (segundos) para um pedido inteiro do usuário (todas as chamadas, tentativas e esperas somadas).
# Passou disso, o usuário recebe um aviso amigável em vez de esperar minutos. Pode estourar até LLM_TIMEOUT_S
# além do limite, porque uma chamada já em andamento não é cortada no meio.
LLM_PRAZO_TOTAL_S=60

# Banco: SQLite local funciona sem instalar nada. Em produção (Railway) vira Postgres.
DATABASE_URL=sqlite:///./data/cerebro.db

# Ambiente
APP_ENV=dev

# Preço do modelo (US$ por 1 milhão de tokens), para o custo estimado no log.
# gemini-3.8-flash até 31/12/2026. Em 01/01/2027 o preço sobe: confira a página de preços e atualize.
PRECO_ENTRADA_1M=0.75
PRECO_SAIDA_1M=3.75

# Token da integração INTERNA do Notion (T4, importação). Quem cria a integração é o Davi (dono do workspace) e passa o
# token. Só aqui: nunca no chat, no código ou em print. Capacidades da integração: só "Read content" e
# "No user information". Ela só enxerga as páginas compartilhadas com ela (••• → Connections → a integração).
NOTION_TOKEN=

# --- Google Drive (T6) ---------------------------------------------------------------------------------------------
# O id da pasta "Conhecimento Comercial": o final do endereço dela no Drive (drive.google.com/drive/folders/<ID>).
# Para VÁRIAS pastas, separe por vírgula (cada uma pode ser o id ou o endereço inteiro). A 1ª é a principal. As outras
# entram com o nome delas no começo da categoria. Todas precisam estar compartilhadas com a conta de serviço.
DRIVE_PASTA_ID=
# A credencial da CONTA DE SERVIÇO (só leitura). Use UMA das duas:
#   no computador: o caminho do arquivo .json que o Google deu (guarde fora da pasta do projeto; nomes como service-account*.json e credenciais*.json já estão no .gitignore)
GOOGLE_APPLICATION_CREDENTIALS=
#   na Railway (não há arquivo): o CONTEÚDO inteiro do .json, numa linha só
GOOGLE_SERVICE_ACCOUNT_JSON=
# Arquivo maior que isto (em MB) nem é baixado: os PDFs de slides de 50 MB são imagem e não têm texto.
DRIVE_MAX_MB=30
# Corte por idade: arquivo sem edição há mais de N anos nem entra (0 = sem corte). Vale a data de edição do Drive. Vídeo
# nunca entra. O que sobrou chega ao consultor com a data de edição, e o mais recente vale mais.
DRIVE_IDADE_MAX_ANOS=0
# Documento com mais trechos que isto (cada um ~8 mil caracteres) fica só na busca, sem ir ao curador (que custa).
DRIVE_MAX_TRECHOS=12
# Sincronização automática: de quantos em quantos minutos o servidor olha a pasta (0 = desligado; 15 é um bom valor).
# Só baixa o que mudou, então rodada sem novidade quase não custa. O curador gasta no máximo DRIVE_SYNC_TETO_USD por rodada.
DRIVE_SYNC_INTERVALO_MIN=0
DRIVE_SYNC_TETO_USD=0.5

# --- Login com o Google (T5) ---
# Sem GOOGLE_CLIENT_ID, o login fica DESLIGADO no dev: todos entram como "Dev local".
# Em produção (APP_ENV=prod) o app NÃO sobe sem as três primeiras. Passo a passo: docs/deploy-railway.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Assina o cookie de sessão. Em prod: 32+ caracteres aleatórios (python -c "import secrets; print(secrets.token_urlsafe(48))")
SESSION_SECRET=
# O endereço onde o app roda: o Google devolve o login em APP_URL/auth/callback. Em prod, https://.
APP_URL=http://localhost:8000
# Só e-mails deste domínio entram.
AUTH_DOMINIO=citi.org.br
SESSAO_DIAS=7
